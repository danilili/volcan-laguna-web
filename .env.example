# Beds24 (API v2), read-only. In the Beds24 panel (SETTINGS > MARKETPLACE > API)
# click "Generate invite code" with scopes read:inventory and read:properties,
# "allow linked properties" ticked and no IP whitelist, then run
# `pnpm beds24:setup`: it exchanges the code and fills ONE of the two vars.
# BEDS24_TOKEN: long-life token, sent as-is (expires after 90 days unused).
BEDS24_TOKEN=
# BEDS24_REFRESH_TOKEN: the site exchanges it for 24 h access tokens.
# Leave empty when BEDS24_TOKEN is set.
BEDS24_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# n8n bridge for web bookings: workflow "VL · reserva-web" (POST, JSON body
# {casa, arrival, departure, personas, nombre, telefono, correo, total, origen, mensaje}).
# Production URL: https://reservalia.app.n8n.cloud/webhook/vl-reserva-web
N8N_BOOKING_WEBHOOK=
# Value of the X-VL-Web-Secret header the webhook requires (n8n Header Auth
# credential "VL · reserva-web secret"). D4ny generates it and sets it in both places.
N8N_WEBHOOK_SECRET=
REVALIDATE_SECRET=
BLOB_READ_WRITE_TOKEN=
