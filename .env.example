# Beds24 (API v2). Long-life token, read-only, generated in the Beds24 panel:
# SETTINGS > MARKETPLACE > API > "long life token" with scopes read:inventory
# and read:properties, "allow linked properties" ticked. Used as-is.
BEDS24_TOKEN=
# Alternative: a refresh token from an invite code; the site exchanges it for
# 24 h access tokens. Leave empty when BEDS24_TOKEN is set.
BEDS24_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
N8N_BOOKING_WEBHOOK=
N8N_WEBHOOK_SECRET=
REVALIDATE_SECRET=
BLOB_READ_WRITE_TOKEN=
